{
  "name": "@bitbaum/site",
  "private": true,
  "version": "0.0.0",
  "description": "The studio site. A static generator and stylesheet using shared design tokens and listkit query rules.",
  "type": "module",
  "scripts": {
    "build": "node site/build.mjs",
    "check": "node site/build.mjs --check",
    "test": "node --test site/*.test.mjs",
    "publish:site": "bash site/publish.sh",
    "check:claims": "node site/check-claims.mjs",
    "check:hire": "node site/check-hire.mjs",
    "check:theme": "node site/check-theme.mjs",
    "check:responsive": "node site/check-responsive.mjs",
    "check:widget": "node site/check-widget.mjs",
    "check:studio": "node site/check-studio.mjs",
    "check:cast": "node site/check-cast.mjs",
    "check:contrast": "node site/check-contrast.mjs",
    "check:packages": "node site/check-packages.mjs"
  },
  "dependencies": {
    "@bitbaum/chatkit": "^0.20.1",
    "@bitbaum/design-tokens": "1.2.0",
    "bip-kit": "^0.6.1",
    "listkit": "npm:@bitbaum/listkit@^0.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.63.0"
  },
  "packageManager": "pnpm@11.25.0"
}
