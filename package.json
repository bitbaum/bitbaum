{
  "name": "@bitbaum/site",
  "private": true,
  "version": "0.0.0",
  "description": "The studio site. A static generator and stylesheet using shared design tokens and listkit query rules.",
  "type": "module",
  "scripts": {
    "build": "node site/build.mjs",
    "check": "node site/build.mjs --check",
    "test": "node --test site/*.test.mjs",
    "publish:site": "bash site/publish.sh"
  },
  "dependencies": {
    "@bitbaum/design-tokens": "1.1.0",
    "listkit": "github:bitbaum/listkit#v0.1.0"
  }
}
